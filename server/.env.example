# ------------------------------------------------------------------------------
#  Gramrosh API — environment template
#  Copy to server/.env (dev) or set as real env vars (production).
#  Every value has a safe development default; production boot *refuses* the
#  dev JWT secret, the default admin password and the memory DB driver.
# ------------------------------------------------------------------------------

# --- core ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- database -----------------------------------------------------------------
# memory  → in-process engine, persists to server/.data (dev/CI, no install)
# mongodb → real MongoDB via MONGO_URI (required in production)
DB_DRIVER=memory
MONGO_URI=mongodb://127.0.0.1:27017/gramrosh
# MEMORY_DB_PERSIST=true

# --- auth ---------------------------------------------------------------------
# Must be at least 32 characters in production.
JWT_SECRET=change-me-to-a-long-random-string-32ch
JWT_EXPIRES_IN=12h

# Bootstrap super-admin (created on first boot if no admin exists).
ADMIN_NAME=Gramrosh Admin
ADMIN_EMAIL=admin@gramrosh.test
ADMIN_PASSWORD=Admin@1234

# --- commerce -----------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=2500
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=60

# --- images (Cloudinary CDN; leave blank to use the local WebP transcoder) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gramrosh
# Optional custom CDN/CNAME in front of Cloudinary:
CDN_BASE_URL=
UPLOAD_MAX_MB=6

# --- HTTP ---------------------------------------------------------------------
# Comma-separated allowlist; dev reflects any origin.
CORS_ORIGINS=
CACHE_MAX_AGE=60
CACHE_S_MAXAGE=300

# --- rate limiting --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_ORDER_MAX=30
